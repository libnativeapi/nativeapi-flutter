# Copy to ../hosts/<name>.env (git-ignored) and fill in.
HOST_OS='macos'
HOST_SSH='user@192.168.0.12'                # ssh target (Remote Login on); key-based login must work
HOST_WORKSPACE='/Users/user/Projects/libnativeapi/workspace'
HOST_SCRATCH='/Users/user/tmp/claude'       # scratch directory; no spaces in the path
HOST_PYTHON='python3'
HOST_PATH_PREPEND=''                        # optional, ':'-separated
