# Copy to ../hosts/<name>.env (git-ignored) and fill in. Single quotes keep backslashes.
HOST_OS='windows'
HOST_SSH='User@192.168.0.10'                      # ssh target; key-based login must work
HOST_WORKSPACE='D:\Projects\libnativeapi\workspace'  # the project checkout on that machine
HOST_SCRATCH='D:\tmp\claude'                      # scratch directory; no spaces in the path
HOST_PYTHON='C:\Python311\python.exe'             # Python 3 (for uiprobe.py)
HOST_PATH_PREPEND=''                              # optional, ';'-separated: e.g. a Flutter SDK bin directory
