# Copy to ../hosts/<name>.env (git-ignored) and fill in.
HOST_OS='linux'
HOST_SSH='user@192.168.0.11'                # ssh target; key-based login must work
HOST_WORKSPACE='/home/user/libnativeapi/workspace'
HOST_SCRATCH='/home/user/tmp/claude'        # scratch directory; no spaces in the path
HOST_PYTHON='python3'
HOST_PATH_PREPEND=''                        # optional, ':'-separated
HOST_DISPLAY=':0'                           # X display of the logged-on desktop session
