{%- from 'partials/type_map.j2' import map_type, is_string_type -%}
{%- from 'partials/symbol_map.j2' import capi_for_method -%}

{%- macro string_param_name(name) -%}
{{ name }}_native
{%- endmacro -%}

{%- macro render_class(cls, mapping) -%}
pub struct {{ cls.name }} {
    pub handle: *mut ::core::ffi::c_void,
}

impl {{ cls.name }} {
{%- for method in cls.methods %}
{%- if method.name != cls.name and not method.name.startswith('~') %}
    #[inline]
    pub fn {{ method.name | snake_case }}(
    {%- if not method.static %}
        &self{% if method.params|length > 0 %},{% endif %}
    {%- endif %}
    {%- for p in method.params %}
        {{ p.name | snake_case }}: {{ map_type(p.type, mapping) }}{% if not loop.last %},{% endif %}
    {%- endfor %}
    ) -> {{ method.return_type }} {
{%- for p in method.params %}
{%- if is_string_type(p.type) %}
        let {{ string_param_name(p.name) }} = std::ffi::CString::new({{ p.name | snake_case }}).unwrap();
{%- endif %}
{%- endfor %}
        unsafe {
{%- if method.return_bridge == 'struct' %}
        let result = ffi::{{ capi_for_method(cls, method, mapping) }}(
        {%- if method.needs_instance_handle %}
            self.handle{% if method.params|length > 0 %},{% endif %}
        {%- endif %}
        {%- for p in method.params %}
{%- if is_string_type(p.type) %}
            {{ string_param_name(p.name) }}.as_ptr(){% if not loop.last %},{% endif %}
{%- else %}
            {{ p.name | snake_case }}{% if not loop.last %},{% endif %}
{%- endif %}
{%- endfor %}
        );
        std::mem::transmute::<ffi::{{ method.native_return_type }}, {{ method.return_type }}>(result)
{%- else %}
        ffi::{{ capi_for_method(cls, method, mapping) }}(
        {%- if method.needs_instance_handle %}
            self.handle{% if method.params|length > 0 %},{% endif %}
        {%- endif %}
        {%- for p in method.params %}
{%- if is_string_type(p.type) %}
            {{ string_param_name(p.name) }}.as_ptr(){% if not loop.last %},{% endif %}
{%- else %}
            {{ p.name | snake_case }}{% if not loop.last %},{% endif %}
{%- endif %}
{%- endfor %}
        )
{%- endif %}
        }
    }

{%- endif %}
{%- endfor %}
}
{%- endmacro -%}
