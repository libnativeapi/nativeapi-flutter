[submodule "nativeapi"]
	path = core
	url = ../nativeapi-core.git
	branch = main
[submodule "packages/cnativeapi/cxx_impl"]
	path = bindings/flutter/cnativeapi/cxx_impl
	url = https://github.com/libnativeapi/nativeapi-core.git
[submodule "crates/cnativeapi/cxx_impl"]
	path = bindings/rust/cnativeapi/cxx_impl
	url = https://github.com/libnativeapi/nativeapi-core.git
[submodule "cxx_impl"]
	path = bindings/csharp/src/CNativeAPI/cxx_impl
	url = https://github.com/libnativeapi/nativeapi-core.git
